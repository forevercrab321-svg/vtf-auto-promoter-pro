# ============================================================================
# BountyOS — environment configuration
# Copy this file to ".env" and fill in values. NEVER commit ".env".
# ============================================================================

# --- Database -------------------------------------------------------------
# Local development uses SQLite (zero setup). This is the default.
DATABASE_URL="file:./dev.db"

# For production / deploy, switch to PostgreSQL or Supabase instead:
#   1. In prisma/schema.prisma set: provider = "postgresql"
#   2. Set DATABASE_URL below to your connection string.
# DATABASE_URL="postgresql://user:password@host:5432/bountyos?schema=public"


# --- LLM provider (OPTIONAL) ----------------------------------------------
# The app runs WITHOUT any key using deterministic templates.
# Provide ONE provider to enable AI-assisted drafting (hypotheses, reports).
#
# LLM_PROVIDER options: "none" (default), "anthropic", "openai", "gemini"
LLM_PROVIDER="none"

# Anthropic Claude
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"

# OpenAI
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Google Gemini
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-1.5-flash"


# --- Safety switches ------------------------------------------------------
# Master kill-switch. When "false", no test task can ever be marked EXECUTED
# and the Safe Testing layer stays in planning-only mode.
ENABLE_ACTIVE_TESTING="false"
